{
  "framework": null,
  "installCommand": "npm install",
  "buildCommand": "npm run build && rm -rf dist && mkdir dist && cp -R public/. dist/ && rm -f dist/index.php dist/.htaccess",
  "outputDirectory": "dist",
  "regions": ["fra1"],
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.9.0",
      "excludeFiles": "{node_modules,tests,docs,public,crystal-shine-pos,.github}/**"
    }
  },
  "routes": [
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/api/index.php" }
  ]
}
