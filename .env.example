APP_NAME="USIU Hostel"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Database — use MySQL for production, SQLite for quick demo
DB_CONNECTION=sqlite
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=hostel_management
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hostel@usiu.ac.ke"
MAIL_FROM_NAME="${APP_NAME}"

# Hostel settings
HOSTEL_BOOKING_FEE=15000
INSTITUTIONAL_EMAIL_DOMAIN=students.usiu.ac.ke

# M-Pesa Daraja Sandbox — get credentials from developer.safaricom.co.ke
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
# Sandbox passkey for shortcode 174379 — replace with your app passkey for production
MPESA_PASSKEY=bfb279f9aa9bdbcf158e97dd71a467cd2e0c893059b10f78e6b72ada1ed2c919
MPESA_SHORTCODE=174379
MPESA_CALLBACK_URL="${APP_URL}/mpesa/callback"
MPESA_ENVIRONMENT=sandbox
# Sandbox: true = any valid Kenyan number completes payment (demo). Production Go Live = real STK on any phone.
MPESA_DEMO_ANY_PHONE=false

# SMS (stubbed in dev — Africa's Talking)
AFRICASTALKING_USERNAME=
AFRICASTALKING_API_KEY=
AFRICASTALKING_FROM=USIUHOSTEL

VITE_APP_NAME="${APP_NAME}"
